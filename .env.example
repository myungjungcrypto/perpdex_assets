# ─── Google Sheets (optional — omit to disable) ───
# Service account JSON (single line, or path to file)
# GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"your-project","private_key_id":"...","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"monitor@your-project.iam.gserviceaccount.com","client_id":"...","auth_uri":"https://accounts.google.com/o/oauth2/auth","token_uri":"https://oauth2.googleapis.com/token"}
# GOOGLE_SPREADSHEET_ID=your_spreadsheet_id_from_url
# Optional: custom sheet tab names (defaults shown)
# GOOGLE_BALANCE_LOG_SHEET=Balance Log
# GOOGLE_SUMMARY_SHEET=Summary

# ─── Telegram ───
TELEGRAM_BOT_TOKEN=123456789:ABCDefGhIJKlmNOPQRstuvWXYZ
TELEGRAM_CHAT_ID=your_chat_id
# Optional: enable /status command polling (set true on only one instance per bot token)
# TELEGRAM_ENABLE_COMMANDS=false
# Optional: polling interval for Telegram command handling (/status), default 5000
# TELEGRAM_COMMAND_POLL_INTERVAL_MS=5000

# ─── Paradex (Read-Only JWT) ───
# Generate via POST /auth endpoint
PARADEX_JWT_TOKEN=

# ─── Lighter (Read-Only Token) ───
# Format: ro:{account}:{scope}:{expiry}:{hex}
LIGHTER_RO_TOKEN=

# ─── Extended (API Key) ───
# Generate at Extended API Management page
EXTENDED_API_KEY=

# ─── Pacifica (Solana wallet address only, no key needed) ───
# Supports multiple addresses (comma-separated): addr1,addr2
PACIFICA_WALLET_ADDRESS=

# ─── Nado (wallet address only, no key needed for read) ───
# Supports multiple addresses (comma-separated): addr1,addr2
NADO_WALLET_ADDRESS=

# ─── 01 Exchange (N1 / Nord — wallet address only) ───
O1_WALLET_ADDRESS=

# ─── Variational (API not yet available) ───
# VARIATIONAL_API_KEY=
# VARIATIONAL_API_SECRET=

# ─── Hyperliquid (wallet address only, no key needed for read) ───
# Supports multiple addresses (comma-separated): addr1,addr2
HYPERLIQUID_WALLET_ADDRESS=
# HIP-3 perp dexes to track (comma-separated, e.g. xyz for RWA stocks)
# HYPERLIQUID_HIP3_DEXES=xyz

# ─── Risk Thresholds (%) ───
# RISK_WARNING_PERCENT=20
# RISK_DANGER_PERCENT=10
# RISK_CRITICAL_PERCENT=5
# ALERT_COOLDOWN_MINUTES=30
# Per-position liquidation-distance thresholds (%) — global defaults
# POSITION_WARNING_DISTANCE=30
# POSITION_DANGER_DISTANCE=15
# POSITION_CRITICAL_DISTANCE=7
# Per-coin overrides: "COIN:warn:danger:critical,COIN2:warn:danger:critical"
# POSITION_CUSTOM_DISTANCES=XYZ100:5:3:1
# trade.xyz RWA stocks (markets prefixed with "xyz:") use tighter thresholds
# POSITION_XYZ_PREFIX=xyz:
# POSITION_XYZ_WARNING_DISTANCE=10
# POSITION_XYZ_DANGER_DISTANCE=5
# POSITION_XYZ_CRITICAL_DISTANCE=2

# ─── Kiwoom Securities (키움증권 REST API) ───
# Issue keys at https://openapi.kiwoom.com
# WARNING: keys carry order permissions — keep this file private (chmod 600)
# KIWOOM_APP_KEY=
# KIWOOM_APP_SECRET=
# Mock trading: https://mockapi.kiwoom.com (default is real: https://api.kiwoom.com)
# KIWOOM_BASE_URL=https://api.kiwoom.com

# ─── Broker polling (minutes between Kiwoom/KB fetches) ───
# BROKER_UPDATE_INTERVAL_MINUTES=5
